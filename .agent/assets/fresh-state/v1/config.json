{
  "schema": "agent-workflow/v2",
  "project": {
    "name": "__PROJECT_NAME__",
    "type": "__PROJECT_TYPE__"
  },
  "routing": {
    "default_mode": "standard",
    "modes": {
      "fast": {
        "token_budget": 16000,
        "max_loaded_references": 1,
        "max_child_agents": 0,
        "clean_reruns": 0,
        "test_strategy": "targeted",
        "wall_time_minutes": 5,
        "max_automatic_test_attempts": 1
      },
      "standard": {
        "token_budget": 48000,
        "max_loaded_references": 3,
        "max_child_agents": 1,
        "clean_reruns": 0,
        "test_strategy": "impact",
        "wall_time_minutes": 15,
        "max_automatic_test_attempts": 1
      },
      "release": {
        "token_budget": 96000,
        "max_loaded_references": 6,
        "max_child_agents": 2,
        "clean_reruns": 1,
        "test_strategy": "impact-plus-one-full-chain",
        "wall_time_minutes": 45,
        "max_automatic_test_attempts": 1
      }
    }
  },
  "testing": {
    "failure_classes": [
      "candidate",
      "test",
      "infrastructure"
    ],
    "preflight_before_full_chain": true,
    "reuse_receipts_when_candidate_unchanged": true,
    "reviewers_may_rerun_full_chain": false,
    "full_chain_owner": "integrator",
    "reviewer_targeted_case_limit": 0,
    "preflight_max_seconds": 60,
    "infrastructure_failure_consumes_code_retry": false,
    "resume_from_failed_case": false,
    "max_automatic_full_chain_attempts": 1,
    "budget_registry": ".agent/state/test-budget.json",
    "budget_receipt_dir": ".agent/state/evidence/test-budgets",
    "attempt_classes": [
      "candidate",
      "test",
      "infrastructure"
    ]
  },
  "branches": {
    "local": [
      "feature/*",
      "fix/*",
      "chore/*"
    ],
    "test": [
      "develop",
      "test/*",
      "release/*"
    ],
    "production": [
      "main"
    ]
  },
  "environments": {
    "local": {
      "deploy_allowed": false,
      "deploy_required": false,
      "human_approval": false
    },
    "test": {
      "deploy_allowed": true,
      "deploy_required": false,
      "human_approval": false
    },
    "production": {
      "deploy_allowed": true,
      "deploy_required": true,
      "human_approval": true
    }
  },
  "guardrails_ready": false,
  "context": {
    "max_bytes": 8192,
    "max_list_items": 30,
    "max_capsule_tokens": {
      "fast": 1000,
      "standard": 1200,
      "release": 2000
    },
    "estimated_turn_overhead_tokens": {
      "fast": 2000,
      "standard": 3000,
      "release": 4000
    },
    "bootstrap_overhead_tokens": 7000,
    "soft_budget_ratio": 0.6,
    "compact_budget_ratio": 0.75,
    "hard_budget_ratio": 0.9,
    "max_active_checkpoint_age_minutes": 45,
    "max_rollback_entries": 4,
    "max_failure_entries": 8,
    "max_failure_archive_depth": 32,
    "host_compaction_observer": {
      "source": "host-runtime-receipt",
      "signed_adapter": null,
      "max_receipt_age_seconds": 300
    }
  },
  "evidence_retention": {
    "active_max_bytes": 4194304,
    "min_age_hours": 24,
    "min_archive_bytes": 262144,
    "max_archives": 32,
    "archive_format": "deterministic-zip-deflate-v1",
    "preserve_referenced": true
  },
  "context_transport": {
    "default": "native",
    "pxpipe": {
      "enabled": false,
      "activation": "explicit-opt-in",
      "plugin_name": "pxpipe-context",
      "plugin_version": "0.1.0+codex.20260721210500",
      "models": [
        "gpt-5.6-sol"
      ],
      "primary_mode": "provider-proxy",
      "provider_activation": "default-new-local-sessions",
      "provider_configuration": "user-model-provider-plus-launch-agent",
      "provider_content_scope": "whole-request-eligible-content",
      "mcp_role": "optional-cold-reference",
      "selection": "analyze-then-render",
      "content_scope": "new-cold-reference-only",
      "session_boundary": "plugin-load-requires-new-chat",
      "fallback": "native"
    }
  },
  "runtime": {
    "registry": ".agent/state/runtime.json",
    "tool_leases_registry": ".agent/state/tool-leases.json",
    "term_timeout_seconds": 8
  },
  "agent_control": {
    "default_model": "gpt-5.6-sol",
    "allow_model_fallback": false,
    "context_strategy": "long-window-capsule",
    "max_fork_turns": 10,
    "capacity_retry_limit": 1,
    "max_task_payload_input_count": 24,
    "max_task_payload_single_bytes": 131072,
    "max_task_payload_total_bytes": 262144,
    "max_task_payload_estimated_tokens": 65536,
    "inherit_parent_history": false,
    "dispatch_payload_token_limits": {
      "fast": 0,
      "standard": 16000,
      "release": 32000
    },
    "platform_limit": 4,
    "reserve_root_slots": 1,
    "status_interval_seconds": 30,
    "monitor_grace_seconds": 30,
    "stall_timeout_seconds": 300,
    "allowed_role_types": [
      "worker",
      "researcher",
      "documentation-worker",
      "implementer",
      "reviewer",
      "adversarial",
      "cross",
      "integrator"
    ],
    "review_role_types": [
      "reviewer",
      "adversarial",
      "cross",
      "integrator"
    ],
    "status_request_after_unchanged_checks": 1,
    "max_redispatch": 1,
    "usage_observer": {
      "source": "host-session-usage",
      "automatic_gate_trust": false,
      "provider_verification_required": true,
      "signed_adapter": null,
      "max_receipt_age_seconds": 300
    },
    "platform_observer": {
      "source": "orchestrator-tool-transcript",
      "automatic_release_trust": false,
      "human_verification_required": true,
      "signed_adapter": null
    },
    "human_decision_observer": {
      "source": "orchestrator-user-message",
      "automatic_gate_trust": false,
      "human_verification_required": true,
      "allow_current_chat_local_release": false,
      "signed_adapter": null,
      "max_receipt_age_seconds": 900
    },
    "provider_preflight_observer": {
      "source": "provider-read-only-api",
      "automatic_release_trust": false,
      "provider_verification_required": true,
      "signed_adapter": null,
      "max_receipt_age_seconds": 300
    },
    "default_fork_turns": 0,
    "inherited_turn_estimated_tokens": 800,
    "child_system_tool_margin_tokens": 4000,
    "child_output_margin_tokens": 2000,
    "scheduler": {
      "source": "host-scheduler",
      "signed_adapter": null,
      "automatic_resume": false,
      "max_receipt_age_seconds": 300
    }
  },
  "acceptance": {
    "report_path": ".agent/state/FINAL_ACCEPTANCE.md",
    "client_profile": ".agent/acceptance-client.json"
  },
  "acceptance_adapters": {
    "acceptance-workflow": {
      "implemented": true,
      "runner": ".agent/skills/run-full-chain-acceptance/scripts/run_workflow_release_gate.py",
      "receipt_schema": "workflow-release-gate/v4"
    },
    "acceptance-web-docker": {
      "implemented": true,
      "runner": ".agent/skills/run-full-chain-acceptance/scripts/run_live_release_gate.py",
      "receipt_schema": "acceptance-live-gate/v2"
    },
    "acceptance-api": {
      "implemented": true,
      "runner": ".agent/skills/run-full-chain-acceptance/scripts/run_workflow_release_gate.py",
      "receipt_schema": "local-command-release-gate/v1"
    },
    "acceptance-cli": {
      "implemented": true,
      "runner": ".agent/skills/run-full-chain-acceptance/scripts/run_workflow_release_gate.py",
      "receipt_schema": "local-command-release-gate/v1"
    },
    "acceptance-ios": {
      "implemented": true,
      "runner": ".agent/skills/run-full-chain-acceptance/scripts/run_workflow_release_gate.py",
      "receipt_schema": "local-command-release-gate/v1"
    }
  },
  "scope": {
    "fingerprint_paths": [
      ".agent/config.json",
      ".agent/scripts",
      ".agent/skills",
      ".agent/assets",
      ".agent/templates",
      ".agent/workflows",
      ".agent/state/TASK.json",
      ".agent/state/REQUIREMENT_CONTRACT.md",
      ".agent/policies/PROJECT_GUARDRAILS.md",
      "README.md",
      "AGENTS.md",
      "install.py",
      "tests",
      "plugins/pxpipe-context",
      ".agents/plugins/marketplace.json"
    ],
    "product_roots": [
      "."
    ]
  },
  "token_estimation": {
    "schema": "agent-token-estimation/v1",
    "max_error_ratio": 0.35,
    "direct_read_assurance": "unmetered-possible"
  },
  "project_initialization": null
}
