{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-skill-policy/v1",
  "title": "Dynamic Skill policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "allowed_hosts",
    "offline_content_catalogs",
    "allowed_licenses",
    "minimum_score",
    "maximum_candidates",
    "maximum_skill_bytes",
    "maximum_license_bytes",
    "github_request_budget",
    "maximum_recommendation_age_hours",
    "minimum_evolution_samples",
    "minimum_evolution_success_rate",
    "weights"
  ],
  "properties": {
    "schema": {
      "const": "agent-skill-policy/v1"
    },
    "allowed_hosts": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 1
    },
    "allowed_licenses": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {
        "enum": [
          "MIT"
        ]
      },
      "minItems": 1
    },
    "minimum_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "maximum_candidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "maximum_skill_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 1048576
    },
    "maximum_license_bytes": {
      "type": "integer",
      "minimum": 128,
      "maximum": 524288
    },
    "github_request_budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "maximum_recommendation_age_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8760
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relevance",
        "quality",
        "maintenance",
        "security",
        "trust",
        "license"
      ],
      "properties": {
        "relevance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maintenance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "security": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "trust": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "license": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "minimum_evolution_samples": {
      "type": "integer",
      "minimum": 3,
      "maximum": 100
    },
    "minimum_evolution_success_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "offline_content_catalogs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "candidate_set_sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "candidate_set_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
