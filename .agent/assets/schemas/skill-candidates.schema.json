{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-skill-candidates/v2",
  "title": "Untrusted pinned GitHub Skill candidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provenance",
    "candidates"
  ],
  "properties": {
    "schema": {
      "const": "agent-skill-candidates/v2"
    },
    "candidates": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository",
          "commit",
          "path",
          "content",
          "license"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "repository": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host",
              "owner",
              "name",
              "repository_id",
              "owner_type",
              "archived",
              "fork",
              "stars",
              "pushed_at"
            ],
            "properties": {
              "host": {
                "const": "github.com"
              },
              "owner": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "repository_id": {
                "type": "integer"
              },
              "owner_type": {
                "type": "string"
              },
              "archived": {
                "type": "boolean"
              },
              "fork": {
                "type": "boolean"
              },
              "stars": {
                "type": "integer"
              },
              "pushed_at": {
                "type": "string"
              }
            }
          },
          "commit": {
            "type": "string",
            "minLength": 40,
            "maxLength": 40
          },
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "spdx",
              "path",
              "content",
              "documents"
            ],
            "properties": {
              "spdx": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "documents": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "kind", "content"],
                  "properties": {
                    "path": {"type": "string"},
                    "kind": {"enum": ["license", "notice"]},
                    "content": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "source",
        "blueprint_sha256",
        "query",
        "requests",
        "observed_at",
        "candidate_set_sha256"
      ],
      "properties": {
        "mode": {
          "enum": [
            "github-api",
            "offline-user-reviewed"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "blueprint_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "query": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "requests": {
          "type": "integer",
          "minimum": 0
        },
        "observed_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "candidate_set_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
